<Window x:Class="NeptunoWPF.Views.CategoriasView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Categorías"
        Height="650"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F4F1EA">

    <Window.Resources>

        <SolidColorBrush x:Key="ColorPrincipal" Color="#174A45"/>
        <SolidColorBrush x:Key="ColorHover" Color="#21665F"/>
        <SolidColorBrush x:Key="ColorTexto" Color="#263238"/>
        <SolidColorBrush x:Key="ColorSecundario" Color="#6B7280"/>
        <SolidColorBrush x:Key="ColorPanel" Color="#FFFFFF"/>

        <Style x:Key="BotonPrincipal" TargetType="Button">
            <Setter Property="Background"
                    Value="{StaticResource ColorPrincipal}"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="15,9"/>
            <Setter Property="Margin"
                    Value="5"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="{StaticResource ColorHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- TÍTULO -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock Text="Gestión de Categorías"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="{StaticResource ColorTexto}"/>

            <TextBlock Text="Administración del catálogo de categorías"
                       Foreground="{StaticResource ColorSecundario}"
                       Margin="0,5,0,0"/>

        </StackPanel>


        <!-- FORMULARIO -->

        <Border Grid.Row="1"
                Background="{StaticResource ColorPanel}"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,20">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>


                <!-- NOMBRE -->

                <StackPanel Grid.Row="0"
                            Grid.Column="0"
                            Margin="5">

                    <TextBlock Text="Nombre de categoría"
                               Foreground="{StaticResource ColorSecundario}"/>

                    <TextBox x:Name="txtNombre"
                             Height="38"
                             Margin="0,5,0,0"/>

                </StackPanel>


                <!-- DESCRIPCIÓN -->

                <StackPanel Grid.Row="0"
                            Grid.Column="1"
                            Margin="5">

                    <TextBlock Text="Descripción"
                               Foreground="{StaticResource ColorSecundario}"/>

                    <TextBox x:Name="txtDescripcion"
                             Height="38"
                             Margin="0,5,0,0"/>

                </StackPanel>


                <!-- BOTONES -->

                <StackPanel Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,15,0,0">

                    <Button Content="+ Nuevo"
                            Style="{StaticResource BotonPrincipal}"
                            Click="Nuevo_Click"/>

                    <Button Content="Guardar"
                            Style="{StaticResource BotonPrincipal}"
                            Click="Guardar_Click"/>

                    <Button Content="Actualizar"
                            Style="{StaticResource BotonPrincipal}"
                            Click="Actualizar_Click"/>

                    <Button Content="Eliminar"
                            Style="{StaticResource BotonPrincipal}"
                            Click="Eliminar_Click"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- TABLA -->

        <Border Grid.Row="2"
                Background="{StaticResource ColorPanel}"
                CornerRadius="12"
                Padding="20">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <TextBlock Grid.Row="0"
                           Text="Categorías registradas"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ColorTexto}"
                           Margin="0,0,0,15"/>


                <DataGrid Grid.Row="1"
                          x:Name="dgCategorias"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          RowHeight="40">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding CategoriaID}"
                                            Width="80"/>

                        <DataGridTextColumn Header="Categoría"
                                            Binding="{Binding NombreCategoria}"
                                            Width="250"/>

                        <DataGridTextColumn Header="Descripción"
                                            Binding="{Binding Descripcion}"
                                            Width="*"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

    </Grid>

</Window>