<Window x:Class="NeptunoWPF.Views.PedidosView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Pedidos"
        Height="780"
        Width="1250"
        WindowStartupLocation="CenterScreen"
        Background="#F4F1EA">

    <Window.Resources>

        <SolidColorBrush x:Key="ColorPrincipal" Color="#174A45"/>
        <SolidColorBrush x:Key="ColorHover" Color="#21665F"/>
        <SolidColorBrush x:Key="ColorTexto" Color="#263238"/>
        <SolidColorBrush x:Key="ColorSecundario" Color="#6B7280"/>
        <SolidColorBrush x:Key="ColorPanel" Color="#FFFFFF"/>

        <Style x:Key="BotonPrincipal" TargetType="Button">
            <Setter Property="Background"
                    Value="{StaticResource ColorPrincipal}"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="15,9"/>
            <Setter Property="Margin"
                    Value="5"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="{StaticResource ColorHover}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>


    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- TÍTULO -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock Text="Gestión de Pedidos"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="{StaticResource ColorTexto}"/>

            <TextBlock Text="Administración y consulta de pedidos"
                       Foreground="{StaticResource ColorSecundario}"
                       Margin="0,5,0,0"/>

        </StackPanel>


        <!-- FORMULARIO -->

        <Border Grid.Row="1"
                Background="{StaticResource ColorPanel}"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,20">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- CLIENTE -->

                <StackPanel Grid.Row="0"
                            Grid.Column="0"
                            Margin="5">

                    <TextBlock Text="Cliente ID"
                               Foreground="{StaticResource ColorSecundario}"/>

                    <TextBox x:Name="txtCliente"
                             Height="36"/>

                </StackPanel>


                <!-- EMPLEADO -->

                <StackPanel Grid.Row="0"
                            Grid.Column="1"
                            Margin="5">

                    <TextBlock Text="Empleado ID"
                               Foreground="{StaticResource ColorSecundario}"/>

                    <TextBox x:Name="txtEmpleado"
                             Height="36"/>

                </StackPanel>


                <!-- FECHA PEDIDO -->

                <StackPanel Grid.Row="0"
                            Grid.Column="2"
                            Margin="5">

                    <TextBlock Text="Fecha del pedido"
                               Foreground="{StaticResource ColorSecundario}"/>

                    <DatePicker x:Name="dpFechaPedido"
                                Height="36"/>

                </StackPanel>


                <!-- FECHA REQUERIDA -->

                <StackPanel Grid.Row="0"
                            Grid.Column="3"
                            Margin="5">

                    <TextBlock Text="Fecha requerida"
                               Foreground="{StaticResource ColorSecundario}"/>

                    <DatePicker x:Name="dpFechaRequerida"
                                Height="36"/>

                </StackPanel>


                <!-- FECHA ENVÍO -->

                <StackPanel Grid.Row="1"
                            Grid.Column="0"
                            Margin="5">

                    <TextBlock Text="Fecha de envío"
                               Foreground="{StaticResource ColorSecundario}"/>

                    <DatePicker x:Name="dpFechaEnvio"
                                Height="36"/>

                </StackPanel>


                <!-- TRANSPORTISTA -->

                <StackPanel Grid.Row="1"
                            Grid.Column="1"
                            Margin="5">

                    <TextBlock Text="Transportista ID"
                               Foreground="{StaticResource ColorSecundario}"/>

                    <TextBox x:Name="txtTransportista"
                             Height="36"/>

                </StackPanel>


                <!-- DESTINATARIO -->

                <StackPanel Grid.Row="1"
                            Grid.Column="2"
                            Margin="5">

                    <TextBlock Text="Destinatario"
                               Foreground="{StaticResource ColorSecundario}"/>

                    <TextBox x:Name="txtDestinatario"
                             Height="36"/>

                </StackPanel>


                <!-- CIUDAD -->

                <StackPanel Grid.Row="1"
                            Grid.Column="3"
                            Margin="5">

                    <TextBlock Text="Ciudad destino"
                               Foreground="{StaticResource ColorSecundario}"/>

                    <TextBox x:Name="txtCiudad"
                             Height="36"/>

                </StackPanel>


                <!-- PAÍS -->

                <StackPanel Grid.Row="2"
                            Grid.Column="0"
                            Margin="5">

                    <TextBlock Text="País destino"
                               Foreground="{StaticResource ColorSecundario}"/>

                    <TextBox x:Name="txtPais"
                             Height="36"/>

                </StackPanel>


                <!-- BOTONES -->

                <StackPanel Grid.Row="2"
                            Grid.Column="1"
                            Grid.ColumnSpan="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0">

                    <Button Content="+ Nuevo"
                            Style="{StaticResource BotonPrincipal}"
                            Click="Nuevo_Click"/>

                    <Button Content="Guardar"
                            Style="{StaticResource BotonPrincipal}"
                            Click="Guardar_Click"/>

                    <Button Content="Actualizar"
                            Style="{StaticResource BotonPrincipal}"
                            Click="Actualizar_Click"/>

                    <Button Content="Eliminar"
                            Style="{StaticResource BotonPrincipal}"
                            Click="Eliminar_Click"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- LISTADO -->

        <Border Grid.Row="2"
                Background="{StaticResource ColorPanel}"
                CornerRadius="12"
                Padding="20">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- FILTRO DE FECHAS -->

                <Grid Grid.Row="0"
                      Margin="0,0,0,15">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <StackPanel Grid.Column="0"
                                Margin="5">

                        <TextBlock Text="Desde"
                                   Foreground="{StaticResource ColorSecundario}"/>

                        <DatePicker x:Name="dpDesde"
                                    Height="36"/>

                    </StackPanel>


                    <StackPanel Grid.Column="1"
                                Margin="5">

                        <TextBlock Text="Hasta"
                                   Foreground="{StaticResource ColorSecundario}"/>

                        <DatePicker x:Name="dpHasta"
                                    Height="36"/>

                    </StackPanel>


                    <Button Grid.Column="2"
                            Content="Consultar reporte"
                            Style="{StaticResource BotonPrincipal}"
                            Click="Reporte_Click"
                            VerticalAlignment="Bottom"/>


                    <Button Grid.Column="3"
                            Content="Mostrar pedidos"
                            Style="{StaticResource BotonPrincipal}"
                            Click="MostrarPedidos_Click"
                            VerticalAlignment="Bottom"/>

                </Grid>


                <!-- TABLA -->

                <DataGrid Grid.Row="1"
                          x:Name="dgPedidos"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          RowHeight="38">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding PedidoID}"
                                            Width="60"/>

                        <DataGridTextColumn Header="Fecha"
                                            Binding="{Binding FechaPedido, StringFormat=d}"
                                            Width="100"/>

                        <DataGridTextColumn Header="Destinatario"
                                            Binding="{Binding Destinatario}"
                                            Width="180"/>

                        <DataGridTextColumn Header="Ciudad"
                                            Binding="{Binding CiudadDestino}"
                                            Width="140"/>

                        <DataGridTextColumn Header="País"
                                            Binding="{Binding PaisDestino}"
                                            Width="120"/>

                        <DataGridTextColumn Header="Fecha requerida"
                                            Binding="{Binding FechaRequerida, StringFormat=d}"
                                            Width="130"/>

                        <DataGridTextColumn Header="Fecha envío"
                                            Binding="{Binding FechaEnvio, StringFormat=d}"
                                            Width="120"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

    </Grid>

</Window>