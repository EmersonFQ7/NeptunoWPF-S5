<Window x:Class="NeptunoWPF.Views.ProveedoresView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Proveedores"
        Height="780"
        Width="1250"
        WindowStartupLocation="CenterScreen"
        Background="#F4F1EA">

    <Window.Resources>

        <SolidColorBrush x:Key="ColorPrincipal" Color="#174A45"/>
        <SolidColorBrush x:Key="ColorHover" Color="#21665F"/>
        <SolidColorBrush x:Key="ColorTexto" Color="#263238"/>
        <SolidColorBrush x:Key="ColorSecundario" Color="#6B7280"/>
        <SolidColorBrush x:Key="ColorPanel" Color="#FFFFFF"/>

        <Style x:Key="BotonPrincipal" TargetType="Button">
            <Setter Property="Background"
                    Value="{StaticResource ColorPrincipal}"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="15,9"/>
            <Setter Property="Margin"
                    Value="5"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="{StaticResource ColorHover}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>


    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- TÍTULO -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock Text="Gestión de Proveedores"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="{StaticResource ColorTexto}"/>

            <TextBlock Text="Administración y búsqueda de proveedores"
                       Foreground="{StaticResource ColorSecundario}"
                       Margin="0,5,0,0"/>

        </StackPanel>


        <!-- FORMULARIO -->

        <Border Grid.Row="1"
                Background="{StaticResource ColorPanel}"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,20">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- EMPRESA -->

                <StackPanel Grid.Row="0"
                            Grid.Column="0"
                            Margin="5">

                    <TextBlock Text="Empresa"
                               Foreground="{StaticResource ColorSecundario}"/>

                    <TextBox x:Name="txtEmpresa"
                             Height="36"/>

                </StackPanel>


                <!-- CONTACTO -->

                <StackPanel Grid.Row="0"
                            Grid.Column="1"
                            Margin="5">

                    <TextBlock Text="Nombre de contacto"
                               Foreground="{StaticResource ColorSecundario}"/>

                    <TextBox x:Name="txtContacto"
                             Height="36"/>

                </StackPanel>


                <!-- CARGO -->

                <StackPanel Grid.Row="0"
                            Grid.Column="2"
                            Margin="5">

                    <TextBlock Text="Cargo"
                               Foreground="{StaticResource ColorSecundario}"/>

                    <TextBox x:Name="txtCargo"
                             Height="36"/>

                </StackPanel>


                <!-- CIUDAD -->

                <StackPanel Grid.Row="0"
                            Grid.Column="3"
                            Margin="5">

                    <TextBlock Text="Ciudad"
                               Foreground="{StaticResource ColorSecundario}"/>

                    <TextBox x:Name="txtCiudad"
                             Height="36"/>

                </StackPanel>


                <!-- DIRECCIÓN -->

                <StackPanel Grid.Row="1"
                            Grid.Column="0"
                            Margin="5">

                    <TextBlock Text="Dirección"
                               Foreground="{StaticResource ColorSecundario}"/>

                    <TextBox x:Name="txtDireccion"
                             Height="36"/>

                </StackPanel>


                <!-- CÓDIGO POSTAL -->

                <StackPanel Grid.Row="1"
                            Grid.Column="1"
                            Margin="5">

                    <TextBlock Text="Código postal"
                               Foreground="{StaticResource ColorSecundario}"/>

                    <TextBox x:Name="txtCodigoPostal"
                             Height="36"/>

                </StackPanel>


                <!-- PAÍS -->

                <StackPanel Grid.Row="1"
                            Grid.Column="2"
                            Margin="5">

                    <TextBlock Text="País"
                               Foreground="{StaticResource ColorSecundario}"/>

                    <TextBox x:Name="txtPais"
                             Height="36"/>

                </StackPanel>


                <!-- TELÉFONO -->

                <StackPanel Grid.Row="1"
                            Grid.Column="3"
                            Margin="5">

                    <TextBlock Text="Teléfono"
                               Foreground="{StaticResource ColorSecundario}"/>

                    <TextBox x:Name="txtTelefono"
                             Height="36"/>

                </StackPanel>


                <!-- FAX -->

                <StackPanel Grid.Row="2"
                            Grid.Column="0"
                            Margin="5">

                    <TextBlock Text="Fax"
                               Foreground="{StaticResource ColorSecundario}"/>

                    <TextBox x:Name="txtFax"
                             Height="36"/>

                </StackPanel>


                <!-- BOTONES -->

                <StackPanel Grid.Row="2"
                            Grid.Column="1"
                            Grid.ColumnSpan="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0">

                    <Button Content="+ Nuevo"
                            Style="{StaticResource BotonPrincipal}"
                            Click="Nuevo_Click"/>

                    <Button Content="Guardar"
                            Style="{StaticResource BotonPrincipal}"
                            Click="Guardar_Click"/>

                    <Button Content="Actualizar"
                            Style="{StaticResource BotonPrincipal}"
                            Click="Actualizar_Click"/>

                    <Button Content="Eliminar"
                            Style="{StaticResource BotonPrincipal}"
                            Click="Eliminar_Click"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- BÚSQUEDA -->

        <Border Grid.Row="2"
                Background="{StaticResource ColorPanel}"
                CornerRadius="12"
                Padding="20">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <Grid Grid.Row="0"
                      Margin="0,0,0,15">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <StackPanel Grid.Column="0"
                                Margin="5">

                        <TextBlock Text="Buscar por contacto"
                                   Foreground="{StaticResource ColorSecundario}"/>

                        <TextBox x:Name="txtBuscarContacto"
                                 Height="36"/>

                    </StackPanel>


                    <StackPanel Grid.Column="1"
                                Margin="5">

                        <TextBlock Text="Buscar por ciudad"
                                   Foreground="{StaticResource ColorSecundario}"/>

                        <TextBox x:Name="txtBuscarCiudad"
                                 Height="36"/>

                    </StackPanel>


                    <Button Grid.Column="2"
                            Content="Buscar"
                            Style="{StaticResource BotonPrincipal}"
                            Click="Buscar_Click"
                            VerticalAlignment="Bottom"/>


                    <Button Grid.Column="3"
                            Content="Mostrar todos"
                            Style="{StaticResource BotonPrincipal}"
                            Click="MostrarTodos_Click"
                            VerticalAlignment="Bottom"/>

                </Grid>


                <!-- TABLA -->

                <DataGrid Grid.Row="1"
                          x:Name="dgProveedores"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          RowHeight="38">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding ProveedorID}"
                                            Width="55"/>

                        <DataGridTextColumn Header="Empresa"
                                            Binding="{Binding CompaniaNombre}"
                                            Width="180"/>

                        <DataGridTextColumn Header="Contacto"
                                            Binding="{Binding NombreContacto}"
                                            Width="160"/>

                        <DataGridTextColumn Header="Cargo"
                                            Binding="{Binding CargoContacto}"
                                            Width="150"/>

                        <DataGridTextColumn Header="Ciudad"
                                            Binding="{Binding Ciudad}"
                                            Width="120"/>

                        <DataGridTextColumn Header="País"
                                            Binding="{Binding Pais}"
                                            Width="110"/>

                        <DataGridTextColumn Header="Teléfono"
                                            Binding="{Binding Telefono}"
                                            Width="130"/>

                        <DataGridTextColumn Header="Dirección"
                                            Binding="{Binding Direccion}"
                                            Width="200"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

    </Grid>

</Window>