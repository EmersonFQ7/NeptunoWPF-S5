<Window x:Class="NeptunoWPF.Views.ProductosView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Productos"
        Height="750"
        Width="1250"
        WindowStartupLocation="CenterScreen"
        Background="#F4F1EA">

    <Window.Resources>

        <!-- COLORES -->
        <SolidColorBrush x:Key="ColorPrincipal" Color="#174A45"/>
        <SolidColorBrush x:Key="ColorHover" Color="#21665F"/>
        <SolidColorBrush x:Key="ColorFondo" Color="#F4F1EA"/>
        <SolidColorBrush x:Key="ColorTexto" Color="#263238"/>
        <SolidColorBrush x:Key="ColorSecundario" Color="#6B7280"/>
        <SolidColorBrush x:Key="ColorPanel" Color="#FFFFFF"/>

        <!-- BOTÓN PRINCIPAL -->
        <Style x:Key="BotonPrincipal" TargetType="Button">

            <Setter Property="Background"
                    Value="{StaticResource ColorPrincipal}"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="15,9"/>

            <Setter Property="Margin"
                    Value="5"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="{StaticResource ColorHover}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <Grid Margin="30">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- TÍTULO -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock Text="Gestión de Productos"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="{StaticResource ColorTexto}"/>

            <TextBlock Text="Administración del catálogo de productos"
                       Foreground="{StaticResource ColorSecundario}"
                       Margin="0,5,0,0"/>

        </StackPanel>


        <!-- FORMULARIO -->

        <Border Grid.Row="1"
                Background="{StaticResource ColorPanel}"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,20">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="2*"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <!-- NOMBRE -->

                <StackPanel Grid.Row="0"
                            Grid.Column="0"
                            Margin="5">

                    <TextBlock Text="Nombre del producto"
                               Foreground="{StaticResource ColorSecundario}"/>

                    <TextBox x:Name="txtNombre"
                             Height="36"/>

                </StackPanel>


                <!-- PRECIO -->

                <StackPanel Grid.Row="0"
                            Grid.Column="1"
                            Margin="5">

                    <TextBlock Text="Precio"
                               Foreground="{StaticResource ColorSecundario}"/>

                    <TextBox x:Name="txtPrecio"
                             Height="36"/>

                </StackPanel>


                <!-- STOCK -->

                <StackPanel Grid.Row="0"
                            Grid.Column="2"
                            Margin="5">

                    <TextBlock Text="Stock"
                               Foreground="{StaticResource ColorSecundario}"/>

                    <TextBox x:Name="txtStock"
                             Height="36"/>

                </StackPanel>


                <!-- REORDEN -->

                <StackPanel Grid.Row="0"
                            Grid.Column="3"
                            Margin="5">

                    <TextBlock Text="Nivel de reorden"
                               Foreground="{StaticResource ColorSecundario}"/>

                    <TextBox x:Name="txtReorden"
                             Height="36"/>

                </StackPanel>


                <!-- CANTIDAD POR UNIDAD -->

                <StackPanel Grid.Row="1"
                            Grid.Column="0"
                            Margin="5">

                    <TextBlock Text="Cantidad por unidad"
                               Foreground="{StaticResource ColorSecundario}"/>

                    <TextBox x:Name="txtCantidad"
                             Height="36"/>

                </StackPanel>


                <!-- PROVEEDOR -->

                <StackPanel Grid.Row="1"
                            Grid.Column="1"
                            Margin="5">

                    <TextBlock Text="Proveedor ID"
                               Foreground="{StaticResource ColorSecundario}"/>

                    <TextBox x:Name="txtProveedor"
                             Height="36"/>

                </StackPanel>


                <!-- CATEGORÍA -->

                <StackPanel Grid.Row="1"
                            Grid.Column="2"
                            Margin="5">

                    <TextBlock Text="Categoría ID"
                               Foreground="{StaticResource ColorSecundario}"/>

                    <TextBox x:Name="txtCategoria"
                             Height="36"/>

                </StackPanel>


                <!-- DESCONTINUADO -->

                <CheckBox Grid.Row="1"
                          Grid.Column="3"
                          x:Name="chkDescontinuado"
                          Content="Producto descontinuado"
                          VerticalAlignment="Center"
                          Margin="10"/>


                <!-- BOTONES -->

                <StackPanel Grid.Row="2"
                            Grid.ColumnSpan="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0">

                    <Button Content="+ Nuevo"
                            Style="{StaticResource BotonPrincipal}"
                            Click="Nuevo_Click"/>

                    <Button Content="Guardar"
                            Style="{StaticResource BotonPrincipal}"
                            Click="Guardar_Click"/>

                    <Button Content="Eliminar"
                            Style="{StaticResource BotonPrincipal}"
                            Click="Eliminar_Click"/>

                    <Button Content="Actualizar"
                            Style="{StaticResource BotonPrincipal}"
                            Click="Actualizar_Click"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- TABLA -->

        <Border Grid.Row="2"
                Background="{StaticResource ColorPanel}"
                CornerRadius="12"
                Padding="20">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <TextBlock Grid.Row="0"
                           Text="Productos registrados"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ColorTexto}"
                           Margin="0,0,0,15"/>


                <DataGrid Grid.Row="1"
                          x:Name="dgProductos"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          RowHeight="40">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding ProductoID}"
                                            Width="60"/>

                        <DataGridTextColumn Header="Producto"
                                            Binding="{Binding NombreProducto}"
                                            Width="220"/>

                        <DataGridTextColumn Header="Precio"
                                            Binding="{Binding PrecioUnidad}"
                                            Width="100"/>

                        <DataGridTextColumn Header="Stock"
                                            Binding="{Binding UnidadesEnExistencia}"
                                            Width="90"/>

                        <DataGridTextColumn Header="Pedido"
                                            Binding="{Binding UnidadesEnPedido}"
                                            Width="90"/>

                        <DataGridTextColumn Header="Reorden"
                                            Binding="{Binding NivelDeReorden}"
                                            Width="90"/>

                        <DataGridCheckBoxColumn Header="Descontinuado"
                                                Binding="{Binding Descontinuado}"
                                                Width="120"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

    </Grid>

</Window>